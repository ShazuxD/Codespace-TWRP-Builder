{
  "name": "Codespace-TWRP-Builder",
  "image": "docker.io/shazuxdd/twrp-builder",
  "remoteUser": "twrp-builder",
  "containerUser": "twrp-builder",
  "privileged": true,
  "capAdd": [
    "SYS_ADMIN"
  ],
  "runArgs": [
    "--device=/dev/fuse"
  ],
  "postStartCommand": "sudo /usr/local/bin/merge-storage",
  "postStartCommand": "source config.sh"
  "postStartCommand": "sudo /usr/local/bin/setup-swap",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  }
}
